generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceSite {
  nate_landing
  corporate
}

enum RenderJobStatus {
  queued
  rendering
  succeeded
  failed
}

enum ScheduledPostStatus {
  pending
  scheduled
  failed
}

enum BrowserTaskType {
  create_template
  clone_template
  export_renderscript
}

enum BrowserTaskStatus {
  queued
  running
  succeeded
  failed
}

model SourcePage {
  id         String     @id @default(cuid())
  url        String
  sourceSite SourceSite
  title      String?
  rawText    String     @db.Text
  fetchedAt  DateTime   @default(now())
  facts      KbFact[]
}

model KbFact {
  id                 String      @id @default(cuid())
  sourcePageId       String?
  sourcePage         SourcePage? @relation(fields: [sourcePageId], references: [id], onDelete: SetNull)
  sourceSite         SourceSite
  sourceUrl          String
  category           String
  key                String?
  content            String      @db.Text
  metadata           Json?
  campaignProfiles   String[]
  createdAt          DateTime    @default(now())

  @@index([sourceSite])
  @@index([category])
}

model VideoTemplate {
  id                    String      @id @default(cuid())
  name                  String
  creatomateTemplateId  String
  aspectRatio           String      @default("9:16")
  defaultModifications  Json
  renderscriptSource    Json?
  active                Boolean     @default(true)
  createdAt             DateTime    @default(now())
  renderJobs            RenderJob[]
}

model BrowserTask {
  id        String            @id @default(cuid())
  type      BrowserTaskType
  status    BrowserTaskStatus @default(queued)
  input     Json
  output    Json?
  error     String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([type])
}

model RenderJob {
  id                 String           @id @default(cuid())
  status             RenderJobStatus  @default(queued)
  creatomateRenderId String?
  outputUrl          String?
  error              String?          @db.Text
  inputSnapshot      Json
  campaignProfile    String
  videoTemplateId    String?
  videoTemplate      VideoTemplate?   @relation(fields: [videoTemplateId], references: [id], onDelete: SetNull)
  scheduledPosts     ScheduledPost[]
  contentPosts       ContentPost[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model StoredCredential {
  id        String   @id @default(cuid())
  name      String   @unique
  payload   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduledPost {
  id           String               @id @default(cuid())
  renderJobId  String
  renderJob    RenderJob            @relation(fields: [renderJobId], references: [id], onDelete: Cascade)
  ghlPostId    String?
  accountIds   Json
  scheduleDate DateTime
  caption      String               @db.Text
  mediaUrl     String
  postType     String
  status       ScheduledPostStatus  @default(pending)
  rawResponse  Json?
  createdAt    DateTime             @default(now())
}

// ── Social Media Content Strategy ──────────────────────────────────

enum SocialPlatform {
  instagram
  facebook
  tiktok
  twitter
  linkedin
  youtube_shorts
}

enum ContentType {
  reel
  image_post
  carousel
  story
  text_post
}

enum ContentPostStatus {
  draft
  generating
  ready
  scheduled
  published
  failed
}

model ContentPost {
  id              String            @id @default(cuid())
  platform        SocialPlatform
  contentType     ContentType
  status          ContentPostStatus @default(draft)
  campaignProfile String            @default("nate_landing")

  hook            String?
  body            String?           @db.Text
  cta             String?
  hashtags        String[]
  caption         String?           @db.Text

  mediaUrls       String[]
  thumbnailUrl    String?
  renderJobId     String?
  renderJob       RenderJob?        @relation(fields: [renderJobId], references: [id], onDelete: SetNull)

  platformMeta    Json?
  scheduledFor    DateTime?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  calendarSlotId  String?
  calendarSlot    ContentCalendarSlot? @relation(fields: [calendarSlotId], references: [id], onDelete: SetNull)

  @@index([platform])
  @@index([status])
  @@index([campaignProfile])
}

model ContentCalendarSlot {
  id              String            @id @default(cuid())
  date            DateTime
  dayOfWeek       Int
  timeSlot        String
  platform        SocialPlatform
  contentType     ContentType
  topic           String?
  campaignProfile String            @default("nate_landing")
  posts           ContentPost[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([date])
  @@index([platform])
}
