# Postgres (Vercel Postgres, Neon, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Creatomate — https://creatomate.com/docs/api/quick-start/create-a-video-by-template
CREATOMATE_API_KEY=
# Optional: used by prisma seed for default VideoTemplate row
CREATOMATE_TEMPLATE_ID=
# Browser automation (Playwright) — editor login at app.creatomate.com
CREATOMATE_EMAIL=
CREATOMATE_PASSWORD=

# OpenAI — AI chat agent (GPT-4o via Vercel AI SDK)
OPENAI_API_KEY=

# GoHighLevel API v2 — Private Integration Token (pit-...)
GHL_API_TOKEN=
GHL_LOCATION_ID=

# Encrypted credential storage (Settings page → database). Generate e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=
# Optional: require this PIN in the Settings UI to save/remove DB credentials
SETTINGS_ADMIN_PIN=
